# Browser-Use Environment Configuration Template
# Copy this file to .env or set variables in your shell.

# Primary LLM API Keys (Choose one or more):
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Browser Settings
BROWSER_HEADLESS=true
BROWSER_USE_MAX_STEPS=25

# Optional: Path to custom Chrome installation (if not using Playwright default Chromium)
# CHROME_PATH="C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe"
