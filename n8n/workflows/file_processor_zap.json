{
  "name": "OMEGA Autonomous Dropzone Ingestion Zap",
  "nodes": [
    {
      "parameters": {
        "folder": "e:/anti/n8n/dropzone"
      },
      "id": "1",
      "name": "Watch Dropzone Folder",
      "type": "n8n-nodes-base.fileTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "operation": "normalizeSchema",
        "outputFormat": "standardizedJson"
      },
      "id": "2",
      "name": "Normalize & Cleanse Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "destination": "e:/anti/n8n/processed"
      },
      "id": "3",
      "name": "Archive to Processed Storage",
      "type": "n8n-nodes-base.fileWriter",
      "typeVersion": 1,
      "position": [720, 300]
    }
  ],
  "connections": {
    "Watch Dropzone Folder": {
      "main": [
        [
          {
            "node": "Normalize & Cleanse Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize & Cleanse Data": {
      "main": [
        [
          {
            "node": "Archive to Processed Storage",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
